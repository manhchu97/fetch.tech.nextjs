{
  "endOfLine": "lf",
  "printWidth": 80,
  "singleQuote": true,
  "trailingComma": "all",
  "semi": false,
  "jsxSingleQuote": true,
  "useTabs": false,
  "tabWidth": 2,
  "arrowParens": "always",
  "importOrder": [
    "^react(.*$)$",
    "^(react|react-native)$",
    "<THIRD_PARTY_MODULES>",
    "^(@)$",
    "^@components/(.*$)$",
    "^@styles/(.*$)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
