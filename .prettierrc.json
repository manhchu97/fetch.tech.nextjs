{
  "endOfLine": "lf",
  "printWidth": 80,
  "singleQuote": true,
  "trailingComma": "all",
  "semi": false,
  "jsxSingleQuote": true,
  "useTabs": false,
  "tabWidth": 2,
  "arrowParens": "always",
  "importOrder": [
    "^(react)|^(react-(.*)$)|^(react/(.*)$)|^(react$)",
    "^(next)|^(next-(.*)$)|^(next/(.*)$)|^(next$)",
    "<THIRD_PARTY_MODULES>",
    "^(@@)$",
    "^@/config(.*$)$",
    "^@/components(.*$)$",
    "^@/context(.*$)$",
    "^@/hooks(.*$)$",
    "^@/routes(.*$)$",
    "^@/sections(.*$)$",
    "^@/types(.*$)$",
    "^@/utils(.*$)$",
    "^@/styles(.*$)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true
}
